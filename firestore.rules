rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== FUNCIONES DE AYUDA ==========
    function isSignedIn() {
      return request.auth != null;
    }

    function isBusinessMember(negocioId) {
      return isSignedIn()
        && (exists(/databases/$(database)/documents/negocios/$(negocioId)/miembros/$(request.auth.uid))
           || get(/databases/$(database)/documents/negocios/$(negocioId)).data.ownerUid == request.auth.uid);
    }

    function isOwner(negocioId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/negocios/$(negocioId)).data.ownerUid == request.auth.uid;
    }

    // ========== REGLAS POR COLECCIÓN ==========

    match /usuarios/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /negocios/{negocioId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update: if isSignedIn() && isBusinessMember(negocioId);
      allow delete: if isSignedIn() && isOwner(negocioId);

      match /miembros/{mUid} {
        allow read: if isSignedIn() && (mUid == request.auth.uid || isBusinessMember(negocioId));
        allow write: if isSignedIn() && isOwner(negocioId);
      }

      match /clientes/{clienteId} {
        allow read, write: if isBusinessMember(negocioId);
      }

      match /items/{itemId} {
        allow read, write: if isBusinessMember(negocioId);
      }

      match /categorias/{catId} {
        allow read, write: if isBusinessMember(negocioId);
      }

      match /alquileres/{alquilerId} {
        allow read, write: if isBusinessMember(negocioId);

        match /pagos/{pagoId} {
           allow read, write: if isBusinessMember(negocioId);
        }
      }

      // Índices de unicidad (SaaS Security)
      match /clientes_dni_index/{dni} {
        allow read, write: if isBusinessMember(negocioId);
      }

      match /items_codigo_index/{sku} {
        allow read, write: if isBusinessMember(negocioId);
      }

      match /metadata/{docId} {
        allow read: if isBusinessMember(negocioId);
        allow write: if isBusinessMember(negocioId);
      }
    }

    // ========== BLOQUEO DE LEGACY ==========
    match /clientes/{doc} { allow read, write: if false; }
    match /vestuarios/{doc} { allow read, write: if false; }
    match /alquileres/{doc} { allow read, write: if false; }
    match /workspaces/{doc} { allow read, write: if false; }
  }
}
