rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBusinessMember(negocioId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/negocios/$(negocioId)/miembros/$(request.auth.uid));
    }

    // Perfil de usuario
    match /usuarios/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Negocios y toda su data interna
    match /negocios/{negocioId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update: if isBusinessMember(negocioId);

      match /{subcollection=**} {
        allow read, write: if isBusinessMember(negocioId);
      }
    }

    // BLOQUEO TOTAL: colecciones raíz que ya no deben usarse
    match /clientes/{document=**}   { allow read, write: if false; }
    match /vestuarios/{document=**} { allow read, write: if false; }
    match /alquileres/{document=**} { allow read, write: if false; }
    match /clientes_dni_index/{document=**} { allow read, write: if false; }
    match /vestuarios_codigo_index/{document=**} { allow read, write: if false; }

    // Cualquier otra colección no autorizada también se deniega
    match /{document=**} {
      allow read, write: if false;
    }
  }
}