rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBusinessOwner(negocioId) {
      return exists(/databases/$(database)/documents/negocios/$(negocioId)) &&
             get(/databases/$(database)/documents/negocios/$(negocioId)).data.ownerUid == request.auth.uid;
    }

    match /usuarios/{uid} {
      // [C-03] Protection for sensitive plan fields
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['plan', 'itemsLimit', 'clientsLimit', 'workspacesLimit', 'workspacesOwned']);
    }

    match /negocios/{negocioId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);

      match /{allPaths=**} {
        // [C-03] Removed getAfter() to save 1 read per write
        allow read, write: if isSignedIn() && isBusinessOwner(negocioId);
      }
    }

    // [C-01] Rules for purchase validation flow
    match /pendingPurchases/{purchaseId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
