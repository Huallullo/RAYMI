rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBusinessMember(negocioId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/negocios/$(negocioId)/miembros/$(request.auth.uid));
    }

    function isBusinessOwner(negocioId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/negocios/$(negocioId)).data.ownerUid == request.auth.uid;
    }

    // Perfil de usuario
    match /usuarios/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Negocios y toda su data interna
    match /negocios/{negocioId} {
      // Permitir crear si el usuario se marca como dueño
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      // Permitir leer/actualizar a miembros o al dueño (en caso de que el documento de miembro falle)
      allow read, update: if isSignedIn() && (isBusinessMember(negocioId) || resource.data.ownerUid == request.auth.uid);

      // Miembros: El dueño puede crear el primer miembro (él mismo)
      match /miembros/{mUid} {
        allow read, write: if isSignedIn() && (mUid == request.auth.uid || isBusinessMember(negocioId));
      }

      // Subcolecciones internas (clientes, items, alquileres)
      match /{subcollection=**} {
        allow read, write: if isBusinessMember(negocioId);
      }
    }

    // BLOQUEO TOTAL: colecciones raíz antiguas
    match /clientes/{doc} { allow read, write: if false; }
    match /vestuarios/{doc} { allow read, write: if false; }
    match /alquileres/{doc} { allow read, write: if false; }
  }
}
