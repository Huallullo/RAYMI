rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== FUNCIONES DE AYUDA ==========
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(negocioId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/negocios/$(negocioId)).data.ownerUid == request.auth.uid;
    }

    // ========== REGLAS POR COLECCIÓN ==========

    // Perfil de usuario (Seguridad: Solo el admin puede leer/escribir su perfil)
    match /usuarios/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Negocios (SaaS Individual Admin)
    match /negocios/{negocioId} {
      // Solo el creador puede crear el negocio y debe marcarse como owner
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      // Lectura y actualización solo para el dueño
      allow read, update: if isOwner(negocioId);

      // Solo el dueño puede borrar
      allow delete: if isOwner(negocioId);

      // Clientes
      match /clientes/{clienteId} {
        allow read, write: if isOwner(negocioId);
      }

      // Items/Inventario
      match /items/{itemId} {
        allow read, write: if isOwner(negocioId) && request.resource.data.precio >= 0 && request.resource.data.cantidad > 0;
      }

      // Categorías
      match /categorias/{catId} {
        allow read, write: if isOwner(negocioId);
      }

      // Alquileres
      match /alquileres/{alquilerId} {
        allow read, write: if isOwner(negocioId) && request.resource.data.precioTotal >= 0 && request.resource.data.saldo >= 0;

        // Pagos
        match /pagos/{pagoId} {
           allow read, write: if isOwner(negocioId) && request.resource.data.monto > 0;
        }
      }

      // Comprobantes (Validación Senior)
      match /comprobantes/{comprobanteId} {
        allow read: if isOwner(negocioId);
        allow create: if isOwner(negocioId)
          && request.resource.data.total >= 0
          && request.resource.data.numero > 0
          && request.resource.data.tipo in ['TICKET', 'BOLETA', 'FACTURA'];

        allow update: if isOwner(negocioId)
          && (request.resource.data.estado in ['COMPARTIDO', 'ANULADO'])
          && request.resource.data.total == resource.data.total; // Inmutable el monto una vez generado
      }

      // Índices de unicidad
      match /clientes_dni_index/{dni} {
        allow read, write: if isOwner(negocioId);
      }

      match /items_codigo_index/{sku} {
        allow read, write: if isOwner(negocioId);
      }

      // Metadata
      match /metadata/{docId} {
        allow read, write: if isOwner(negocioId);
        // Validar que los correlativos no bajen
        allow update: if isOwner(negocioId) && request.resource.data.ticketNextNumber >= resource.data.ticketNextNumber;
      }
    }

    // Bloqueo de colecciones raíz no autorizadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
