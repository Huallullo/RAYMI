rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBusinessOwner(negocioId) {
      return exists(/databases/$(database)/documents/negocios/$(negocioId)) &&
             get(/databases/$(database)/documents/negocios/$(negocioId)).data.ownerUid == request.auth.uid;
    }

    match /usuarios/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['plan', 'itemsLimit', 'clientsLimit', 'workspacesLimit', 'workspacesOwned']);
    }

    // [C-03] Reglas para acceso directo vía negocio
    match /negocios/{negocioId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);

      match /{allPaths=**} {
        allow read, write: if isSignedIn() && isBusinessOwner(negocioId);
      }
    }

    // ✅ FIX: Reglas para consultas de Grupo (SaaS)
    // Permiten al Dashboard y al Worker buscar en subcolecciones de forma masiva y segura

    match /{path=**}/alquileres/{alquilerId} {
      allow read: if isSignedIn() && isBusinessOwner(resource.data.workspaceId);
    }

    match /{path=**}/pagos/{pagoId} {
      allow read: if isSignedIn() && isBusinessOwner(resource.data.workspaceId);
    }

    match /pendingPurchases/{purchaseId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
