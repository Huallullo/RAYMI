rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBusinessOwner(negocioId) {
      return exists(/databases/$(database)/documents/negocios/$(negocioId)) &&
             get(/databases/$(database)/documents/negocios/$(negocioId)).data.ownerUid == request.auth.uid;
    }

    match /usuarios/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /negocios/{negocioId} {
      // Regla de creación del negocio principal
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      // Regla de lectura/escritura general para el negocio
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);

      // Regla para todas las subcolecciones (Metadata, Clientes, Items, etc.)
      match /{allPaths=**} {
        // Permitimos acceso si ya es dueño (isBusinessOwner)
        // O si lo será después de este batch (getAfter - vital para creación inicial)
        allow read, write: if isSignedIn() && (
          isBusinessOwner(negocioId) ||
          getAfter(/databases/$(database)/documents/negocios/$(negocioId)).data.ownerUid == request.auth.uid
        );
      }
    }

    // Bloqueo por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
