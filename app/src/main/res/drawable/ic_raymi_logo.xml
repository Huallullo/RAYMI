<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Fondo Sólido Indigo (Círculo para mayor limpieza) -->
    <path
        android:pathData="M256,256m-256,0a256,256 0,1 1,512 0a256,256 0,1 1,-512 0"
        android:fillColor="#4F46E5" />

    <!-- Una "R" geométrica y gruesa en Blanco (Legibilidad 100%) -->

    <!-- Cuerpo principal (Rectángulo redondeado) -->
    <path
        android:pathData="M160,120h100c60,0 100,40 100,90s-40,90 -100,90h-100z"
        android:fillColor="#FFFFFF" />

    <!-- Pierna de la R (Simple y sólida) -->
    <path
        android:pathData="M240,300 L340,420"
        android:strokeWidth="60"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"/>

    <!-- Pilar de la R (Para cerrar la forma) -->
    <path
        android:pathData="M160,120h60v300h-60z"
        android:fillColor="#FFFFFF" />

</vector>
